# ===============================
# Database Configuration
# ===============================
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/music_assistant

# SQLite (for local development - no setup required)
# DATABASE_URL=sqlite:///./test.db

# ===============================
# Redis Configuration (for Celery)
# ===============================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ===============================
# Storage Configuration
# ===============================
# Path to storage root directory (defaults to backend/tmp if not set)
STORAGE_ROOT=./tmp

# ===============================
# LLM / OpenAI Configuration
# ===============================
# Required: Your OpenAI API key
OPENAI_API_KEY=sk-your-api-key-here

# Optional: LLM provider (currently only "openai" supported)
LLM_PROVIDER=openai

# Optional: Model name (default: gpt-5)
LLM_MODEL=gpt-5

# ===============================
# Agent Configuration (Optional)
# ===============================
# Maximum steps per agent request (default: 10)
MAX_AGENT_STEPS=10

# Tool execution timeout in seconds (default: 30)
TOOL_TIMEOUT=30
